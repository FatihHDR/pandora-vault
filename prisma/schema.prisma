// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique // Hashed or pseudonymous identifier
  publicKey String // Public key for E2EE and identity verification
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files        FileMetadata[]
  sharedWithMe SharePermission[]
  auditLogs    AuditLog[]
}

model FileMetadata {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Encrypted metadata
  encryptedName String // The file name encrypted by the user
  encryptedMime String // The MIME type encrypted by the user
  size          Int // Size in bytes
  storageId     String // Reference to the encrypted blob in storage (e.g. MinIO/S3 object key)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions SharePermission[]
  auditLogs   AuditLog[]

  @@index([ownerId])
}

model SharePermission {
  id     String       @id @default(uuid())
  fileId String
  file   FileMetadata @relation(fields: [fileId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // E.g. READ, WRITE - can be encrypted or tokenized if needed
  permissionType String @default("READ")

  // The wrapped symmetric key of the file, encrypted with the grantee's public key
  encryptedKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
}

model AuditLog {
  id String @id @default(uuid())

  fileId String?
  file   FileMetadata? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String // e.g., UPLOAD, DOWNLOAD, SHARE, DELETE
  ipAddress String? // Privacy consideration: might want to hash this
  userAgent String?

  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([userId])
}
