generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  
  // Custom columns for Pandora Vault E2EE
  publicKey     String?   

  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  files          FileMetadata[]
  uploadSessions UploadSession[]
  sharedWithMe   SharePermission[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Passkey {
  id             String    @id
  name           String?
  publicKey      String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  webauthnUserID String
  counter        Int
  deviceType     String
  backedUp       Boolean
  transports     String?
  createdAt      DateTime?
}

model FileMetadata {
  id             String   @id @default(uuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  encryptedName  String
  encryptedMime  String
  encryptedDek   String   // DEK encrypted with owner's RSA public key
  iv             String   // Base64-encoded 12-byte IV for AES-256-GCM
  size           Int
  chunkCount     Int      @default(1)
  chunkSize      Int      @default(0)
  storageId      String   // Object key in MinIO bucket

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions    SharePermission[]
  auditLogs      AuditLog[]

  @@index([ownerId])
}

// Tracks in-progress multipart uploads; cleaned up after completion or expiry
model UploadSession {
  id            String   @id @default(uuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  minioUploadId String   // MinIO multipart upload ID
  storageKey    String   // Object key in MinIO bucket

  encryptedName String
  encryptedMime String
  encryptedDek  String
  iv            String
  size          Int
  chunkCount    Int
  chunkSize     Int

  status        String   @default("pending") // pending | complete | aborted
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([ownerId])
}

model SharePermission {
  id             String   @id @default(uuid())
  fileId         String
  file           FileMetadata @relation(fields: [fileId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permissionType String   @default("READ") 
  encryptedKey   String   

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fileId, userId])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  fileId      String?
  file        FileMetadata? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   
  ipAddress   String?  
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([fileId])
  @@index([userId])
}
