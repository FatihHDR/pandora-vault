                      }
                    }
                  }
                }
              },
              "examples": [
                {
                  "name": "Complete Parts Request Example",
                  "data": "{\n  \"parts\": [\n    {\n      \"partNumber\": 1,\n      \"etag\": \"\\\"e2fc714c4727ee9395f324cd2e7f331f\\\"\"\n    },\n    {\n      \"partNumber\": 2,\n      \"etag\": \"\\\"8f9211c4727ee9395f324cd2e7f332a\\\"\"\n    }\n  ]\n}"
                }
              ]
            },
            "description": "Finalizes the MinIO multipart upload and promotes the upload session to a persisted FileMetadata record.",
            "tags": [
              "Storage"
            ],
            "status": "released",
            "ordering": 40,
